# 前端 API 地址
VITE_API_BASE_URL=https://your-backend-domain.zeabur.app

# Logto 配置
VITE_LOGTO_ENDPOINT=https://your-logto-tenant.logto.app
VITE_LOGTO_APP_ID=your_logto_app_id
VITE_LOGTO_REDIRECT_URI=https://your-frontend-domain.zeabur.app/callback
VITE_LOGTO_ACCOUNT_CENTER_URL=https://your-logto-account-center-url

# One authority for backend checkout, frontend form guard, and production Nginx.
# Keep the value identical in both deployed containers.
YIFUT_BASE_URL=https://www.yifut.com

# PostHog 配置
VITE_PUBLIC_POSTHOG_KEY=your_posthog_key
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
