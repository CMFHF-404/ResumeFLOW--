DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<db>
# Docker images carry an immutable production marker. The default local mode
# keeps unittest and direct loopback development compatible; set production
# outside Docker only when all public frontend auth values below are configured.
RESUMEFLOW_DEPLOYMENT_MODE=local
LOGTO_ISSUER=https://<your-tenant-id>.logto.app/oidc
# Logto SPA app IDs are public identifiers: non-empty [A-Za-z0-9_-]+ only.
LOGTO_APP_ID=your_logto_spa_app_id
LOGTO_JWKS_TTL_SECONDS=3600
# Public mirror of the frontend Logto build configuration. Local mode leaves
# these empty and derives them from LOGTO_ISSUER, LOGTO_APP_ID, and
# FRONTEND_ORIGIN. In every remote deployment they are required and must match
# VITE_LOGTO_* exactly; they are application metadata, never Logto secrets.
FRONTEND_LOGTO_ENDPOINT=
FRONTEND_LOGTO_APP_ID=
FRONTEND_LOGTO_REDIRECT_URI=
## Remote FRONTEND_ORIGIN/PUBLIC_API_ORIGIN values must use HTTPS. Plain HTTP
## is accepted only for strict loopback development hosts. In production,
## FRONTEND_ORIGIN must equal the frontend build VITE_FRONTEND_ORIGIN and its
## Logto redirect URI must be FRONTEND_ORIGIN/callback and match
## FRONTEND_LOGTO_REDIRECT_URI exactly.
# Production mode requires FRONTEND_ORIGIN, CORS_ALLOW_ORIGINS, and every
# FRONTEND_LOGTO_* value above. Local mode may derive them for loopback use.
# CORS_ALLOW_ORIGINS must include the same browser origin. For one frontend,
# set it to exactly FRONTEND_ORIGIN as shown below.
CORS_ALLOW_ORIGINS=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173
# Public base URL used in Agent API download URLs. May include one deployment
# mount prefix (for example https://api.example.com/api); never derive it from Host headers.
PUBLIC_API_ORIGIN=http://localhost:8000
EXPORT_SNAPSHOT_TTL_SECONDS=300
EXPORT_RENDER_TIMEOUT_SECONDS=45
EXPORT_TOKEN_SECRET=your_export_token_secret
# Six-dimension resume optimization remains fail-closed until explicitly enabled.
ENABLE_RESUME_OPTIMIZATION=false
RESUME_OPTIMIZATION_MAX_QUESTIONS=5
RESUME_OPTIMIZATION_MAX_BANK_SUGGESTIONS=3
REDEMPTION_CODE_ENCRYPTION_KEY=your_strong_redemption_code_encryption_key
# 易付通 V2 RSA 支付默认关闭。私钥仅配置在后端 Secret，不要提交真实密钥。
YIFUT_ENABLED=false
# 逗号分隔的 Logto user id 白名单；为空时不展示且禁止创建 0.10 元测试套餐。
YIFUT_TEST_USER_IDS=
YIFUT_MERCHANT_ID=your_yifut_merchant_id
YIFUT_MERCHANT_PRIVATE_KEY=your_yifut_merchant_private_key
YIFUT_PLATFORM_PUBLIC_KEY=your_yifut_platform_public_key
# Keep identical to the frontend container's YIFUT_BASE_URL so CSP form-action
# permits exactly the payment provider used to create signed checkout forms.
YIFUT_BASE_URL=https://www.yifut.com
AI_ROUTE_PROFILE=gemini_primary
# gemini_primary routes every AI lane through GEMINI_* with no alternate-provider fallback.
# AI_* remains available only for an explicit rollback to another route profile.
# For openai_primary, qwen_primary, or hybrid_gemini_aifast, explicitly set
# AI_MODEL (and any AI_FAST_MODEL/AI_DEDUPE_MODEL overrides) to a non-Gemini
# model supported by that OpenAI-compatible endpoint.
AI_API_KEY=your_aifast_or_gray_release_api_key
AI_BASE_URL=https://your-aifast-compatible-endpoint.example.com/v1
AI_MODEL=qwen3.7-plus
# Configure AI_FAST_API_KEY and AI_FAST_BASE_URL as a pair. Omit both to reuse
# AI_API_KEY and AI_BASE_URL; never point a fast endpoint at another provider with
# the primary key.
AI_FAST_API_KEY=your_aifast_api_key
AI_FAST_BASE_URL=https://your-aifast-compatible-endpoint.example.com/v1
AI_FAST_MODEL=qwen3.7-plus
AI_DEDUPE_ENABLED=true
AI_DEDUPE_MODEL=qwen3.7-plus
AI_DEDUPE_MAX_CANDIDATES=24
AI_TIMEOUT_SECONDS=300
# Application-level AI request/response budgets. Keep these finite in production.
AI_MAX_REQUEST_BODY_BYTES=8388608
AI_MAX_TEXT_FIELD_CHARS=200000
AI_STREAM_MAX_EVENT_BYTES=262144
AI_STREAM_MAX_TOTAL_BYTES=4194304
AI_STREAM_MAX_EVENTS=10000
AI_ASSISTANT_BUFFER_MAX_CHARS=1048576
AI_STREAM_TOTAL_TIMEOUT_SECONDS=360
AI_STREAM_QUEUE_MAX_EVENTS=64
AI_MAX_OUTPUT_TOKENS=16384
# Responses thinking is used by qwen_primary and openai_primary. It shares
# AI_API_KEY, so this URL must keep the same scheme, host, and port as AI_BASE_URL;
# a different path on the same relay is valid. For DashScope, set both AI_BASE_URL
# and this value to the corresponding DashScope compatible-mode endpoints.
AI_RESPONSES_BASE_URL=https://your-aifast-compatible-endpoint.example.com/v1
# Gemini 3.5 Flash Lite is the single default generation, parsing, dedupe, and thinking model.
# GEMINI_API_KEY is required for production startup while AI_ROUTE_PROFILE=gemini_primary.
GEMINI_API_KEY=your_google_ai_studio_key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.5-flash-lite
AI_THINKING_BUDGET_JD_ANALYSIS=1024
AI_THINKING_BUDGET_POLISH=1024
AI_THINKING_BUDGET_BOSS_GREETING=0
POSTHOG_API_KEY=your_posthog_api_key
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PROJECT_ID=your_posthog_project_id
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-webhook
FEISHU_APP_ID=cli_your_app_id
FEISHU_APP_SECRET=your_app_secret
